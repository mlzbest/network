# 自建后端（backend/）运行时产物
backend/.env
backend/uploads/
# 本地开发数据库数据目录（PGlite / 原生 PG 两种启动器共用命名前缀）
backend/.pgdata*/
# 端到端测试的 esbuild 产物
backend/.tmp/
# npm 仅用于本地应急恢复依赖（项目正式锁文件是 pnpm-lock.yaml）
backend/package-lock.json
# 容器部署的真实环境变量（只提交 deploy/.env.example 模板）
deploy/.env
# Caddy 自动证书与配置缓存（若使用本地挂载而非 volume）
