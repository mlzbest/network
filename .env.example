# H5 / Web 端环境变量模板
# 用法：cp .env.example .env，然后把下面的占位值换成真实值。
# 注意：.env 已被 .gitignore 忽略，切勿把真实密钥提交到公开仓库。

VITE_SUPABASE_URL="https://<your-project>.database.meoo.xyz"
VITE_SUPABASE_ANON_KEY="<supabase-anon-key>"
VITE_ONEDAY_APP_ID="<oneday-app-id>"

# ─── Task #8/#9 承载层网关（部署后取消注释并填入真实值）───
# TCB 云函数网关根：asr / smtp-recovery / net-diagnose / reverse-geocode 都挂在这个域下。
# 未配置时 5 类能力自动回落旧的 supabaseUrl + /functions/v1/* 网关（混合期不炸）。
# VITE_CLOUD_FN_BASE_URL="https://<env-id>.service.tcloudbase.com"
#
# Cloudflare Workers（relay 专用，国际出站）：
# VITE_CLOUD_FN_RELAY_URL="https://ai-relay.<your-account>.workers.dev"

# ─── 鉴权后端 ────────────────────────────────────────────────
# legacy（默认）：Meoo Cloud Supabase 网关，保留「用户名 + 密码 + @meoo.local 占位邮箱」
#   账号体系，同时恢复历史数据 / RLS / Realtime。注册接口必须带 OneDay-App-Id 头，
#   已由 src/supabase/client.ts 的 global.headers 统一注入。
# cloud：WorkBuddy Cloud SDK，signUp 强制要求 OTP 换来的 verificationToken，
#   与纯用户名密码注册冲突；仅作为后续云端移植的预留分支，请勿在当前业务下启用。
VITE_AUTH_BACKEND="legacy"

# ─── WorkBuddy Cloud ───
# 仅 VITE_AUTH_BACKEND=cloud 及云端 LLM/模型目录通道需要；publishableKey 是公开标识。
VITE_CLOUD_ENDPOINT="https://mp-api.app.workbuddy.host"
VITE_CLOUD_PUBLISHABLE_KEY="<workbuddy-publishable-key>"
# Web 端 OAuth 中继（小程序端不需要）
VITE_CLOUD_OAUTH_RELAY_BASE_URL="https://www.workbuddy.cn/v2/as/genie-baas/oauth"
