# 微信小程序 / 钉钉 / 抖音端环境变量模板
# 用法：cp .env.miniprogram.example .env.miniprogram，然后填入真实值。
# 注意：.env.miniprogram 已被 .gitignore 忽略，切勿把真实密钥提交到公开仓库。

VITE_SUPABASE_URL="https://mp-api.meoo.host/mp-api/<oneday-app-id>"
VITE_SUPABASE_ANON_KEY="<supabase-anon-key>"
VITE_ONEDAY_APP_ID="<oneday-app-id>"
VITE_SUPABASE_AUTH_STORAGE_KEY="<oneday-app-id>-auth-token"

# ─── Task #8/#9 承载层网关（与 .env 保持一致）───
# VITE_CLOUD_FN_BASE_URL="https://<env-id>.service.tcloudbase.com"
# VITE_CLOUD_FN_RELAY_URL="https://ai-relay.<your-account>.workers.dev"

# ─── 鉴权后端（与 .env 保持一致）───
# 小程序端同样默认走 Meoo Cloud Supabase 网关，保留用户名 + 密码体系。
# 切到 selfhost（自建后端）时改成 "selfhost"，并填 VITE_SELFHOST_API_BASE；
# 注意小程序真机下该地址必须是已备案 HTTPS 域名，且加入微信 request 合法域名白名单。
VITE_AUTH_BACKEND="legacy"

# 仅 VITE_AUTH_BACKEND=selfhost 生效：自建后端 API 根地址（小程序需 HTTPS 域名）。
# 生产（Cloudflare Workers Free Custom Domain）：
# VITE_SELFHOST_API_BASE="https://api.maolizheng.xyz"
# 切换用项目根的 `node deploy/switch-backend.mjs selfhost --check`，
# 只有 VITE_AUTH_BACKEND 与 VITE_SELFHOST_API_BASE 两个键生效。
# 通用示例：
# VITE_SELFHOST_API_BASE="https://api.your-domain.com"

# ─── WorkBuddy Cloud ───
# 仅 VITE_AUTH_BACKEND=cloud 及云端 LLM/模型目录通道需要。
VITE_CLOUD_ENDPOINT="https://mp-api.app.workbuddy.host"
VITE_CLOUD_PUBLISHABLE_KEY="<workbuddy-publishable-key>"
