# 检测网络 · 容器部署环境变量模板
#
# 用法：cp deploy/.env.example deploy/.env，填好后再执行
#
#   VPS（当前主路径，外部 Postgres + R2）：
#     docker compose -f docker-compose.vps.yml --env-file deploy/.env up -d --build
#     加 --profile tls 启用 Caddy 自动 HTTPS（需公网 80/443）
#   本机全链路（容器内自带 Postgres）：
#     docker compose -f docker-compose.selfhost.yml --env-file deploy/.env up -d --build
#
# ⚠️ deploy/.env 含数据库口令与 JWT 密钥，已加入 .gitignore，绝不提交。

# ─── 外部 Postgres（VPS 模式必填，本机模式留空）─────────────────────────────
# Supabase 免费层：Dashboard → Connect → Session pooler（端口 5432，IPv4）。
#   形如 postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   ⚠ 不要用 6543 transaction pooler：不支持 prepared statements / 会话状态，
#     pg.Pool 长连接与多语句 schema.sql 会出问题。
#   ⚠ 免费层 Direct connection 是 IPv6-only；VPS 若只有 IPv4，一律用 session pooler。
#   ⚠ pooler host 必须从 Connect 对话框复制，不要按 region 自己拼。
#   ⚠ 密码里的 & # ? 空格等保留字符必须 percent-encode，并追加 ?sslmode=require。
# DATABASE_URL=

# ─── 本机内置 Postgres（仅 docker-compose.selfhost.yml 需要）─────────────────
# 密码仅限字母数字，避免拼进 DATABASE_URL 时被当成 URL 特殊字符。
POSTGRES_USER=detect
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=detect_network

# ─── JWT（必改；生成命令：openssl rand -hex 32）───
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=30d

# ─── 对外访问 ───
# 本机映射端口；公网入口请走 Caddy（profile tls）或外部网关
BACKEND_PORT=4000

# 启用 `--profile tls` 时必填，Caddy 会为该域名自动申请证书。
# 前提：DNS A 记录已指向本机，且 80/443 可从公网访问，域名已完成 ICP 备案。
PUBLIC_DOMAIN=localhost

# 对外可访问基址，用于生成图片的绝对 URL（小程序无法加载相对路径）。
# 上线后必须与 PUBLIC_DOMAIN 一致；VPS 模式必须用 https://api.maolizheng.xyz，
# 否则图片 publicUrl 会指向 localhost 导致小程序加载失败。
PUBLIC_BASE_URL=http://localhost:4000

# 允许的前端来源，逗号分隔；生产环境不要留 *
CORS_ORIGINS=*

# ─── 存储 ───
# local：写入容器内 /app/uploads（docker-compose.selfhost.yml 已挂持久卷）
# r2   ：写入 Cloudflare R2（无状态容器 / 机器迁移不丢文件）
# 注：docker-compose.vps.yml 会在 environment 里强制覆盖为 r2，此处仅影响 selfhost。
STORAGE_DRIVER=local

# STORAGE_DRIVER=r2 时前四项必填；在 Cloudflare 控制台 R2 → 管理 API 令牌 获取
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 可选：桶绑定的公开域。留空则图片经后端 /api/storage/public 代理（桶可保持私有）
R2_PUBLIC_URL=
# 可选：覆盖 R2 endpoint / region / 超时（一般不用改）
R2_ENDPOINT=
R2_REGION=auto
R2_TIMEOUT_MS=15000

# ─── 可选：找回密码邮件（不配则「忘记密码」返回 RESET_CONFIG_MISSING）───
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=587
RECOVERY_SMTP_USER=
RECOVERY_SMTP_PASS=
RECOVERY_MAIL_FROM=

# ─── 可选：微信小程序登录（不配则微信登录返回 WX_CONFIG_MISSING）───
WX_APP_ID=
WX_APP_SECRET=
