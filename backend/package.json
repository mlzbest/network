{
  "name": "detect-network-backend",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "description": "自建后端：替代 Meoo Cloud Supabase（Postgres + Node + JWT + Socket.IO）",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/launch.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/launch.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:init": "tsx src/db/init.ts",
    "db:init:dist": "node dist/db/init.js",
    "db:start": "node scripts/dev-db.mjs",
    "db:start:native": "node scripts/dev-db-native.mjs",
    "test:api": "node scripts/smoke.mjs",
    "test:adapter": "node scripts/e2e-adapter.mjs",
    "test:r2": "pnpm build && node scripts/test-r2.mjs",
    "test:r2:live": "pnpm build && node scripts/smoke-r2-live.mjs",
    "test:r2:live:prepare": "pnpm build && node scripts/prepare-r2-live.mjs",
    "test:e2e": "node scripts/smoke.mjs && node scripts/e2e-adapter.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "dotenv": "^17.2.3",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "embedded-postgres": "18.6.0-beta.19",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@embedded-postgres/windows-x64"
    ]
  }
}
