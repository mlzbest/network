# ─── 数据库连接（自托管 Postgres 或 Neon 等托管 PG）───
# 例：postgres://user:password@localhost:5432/detect_network
DATABASE_URL="postgres://user:pass@localhost:5432/detect_network"

# ─── JWT 鉴权 ───
# 必改：用一个长随机串（openssl rand -hex 32）
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="30d"

# ─── 服务端口 ───
PORT="4000"

# ─── 对外可访问基址 ───
# 用于把上传后的相对路径拼成绝对 URL（小程序无法加载相对路径的图片）。
# 本地开发：http://localhost:4000；上线后填真实 HTTPS 域名，如 https://api.example.com
PUBLIC_BASE_URL="http://localhost:4000"

# ─── 前端允许的来源（CORS）───
# 多个用逗号分隔；小程序/web 预览地址都要加
CORS_ORIGINS="http://127.0.0.1:3015,http://localhost:5173"

# ─── 存储（头像 / 聊天图片 / 语音）───
# local：写到 backend/uploads（VPS 有持久卷时用）
# r2   ：写到 Cloudflare R2（Cloudflare Containers 无持久盘，必须用 r2）
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="uploads"

# ─── Cloudflare R2（STORAGE_DRIVER=r2 时前四项必填）───
# 在 Cloudflare 控制台 R2 → 管理 API 令牌 创建 Account ID + Access Key / Secret
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# 可选：桶绑定的公开域（自定义域或 pub-xxx.r2.dev）。
#   填写 → 上传后直接返回该域下的永久 URL，图片不经过后端；
#   留空 → 返回后端 /api/storage/public 代理 URL，桶可保持私有，且 URL 永不过期。
#   注意：头像 URL 会长期存进 profiles，切勿用会过期的预签名 URL。
R2_PUBLIC_URL=""
# 可选：覆盖默认 endpoint（https://<account>.r2.cloudflarestorage.com），
# 用于本地 S3 mock 或其它 S3 兼容服务
R2_ENDPOINT=""
R2_REGION="auto"
R2_TIMEOUT_MS="15000"

# ─── 找回密码发信（不配则「忘记密码」返回 RESET_CONFIG_MISSING）────────────
# MAIL_DRIVER=auto（默认）：有 RESEND_API_KEY 用 Resend，其次自定义 HTTP 网关，
#   最后回落到外部 SMTP；http / smtp 可强制指定单一通道。
# ⚠ Cloudflare Workers Free 没有 TCP socket，SMTP 不可用，必须用 A 或 B。
MAIL_DRIVER="auto"

# 方案 A · Resend（推荐：纯 fetch，https://resend.com）
RESEND_API_KEY=""
# 可覆盖默认 https://api.resend.com/emails（代理 / 本地 mock），一般留空
# RESEND_API_URL=""

# 方案 B · 自定义 HTTP 邮件网关
#   POST <URL>，JSON { from, to, subject, text, html, code, ttl_minutes }
#   RECOVERY_MAIL_API_KEY 以 Authorization: Bearer 传递；无需鉴权则留空
RECOVERY_MAIL_API_URL=""
RECOVERY_MAIL_API_KEY=""
RECOVERY_MAIL_TIMEOUT_MS="15000"
# A / B 都必填发件人（须是已验证域名下的地址）
RECOVERY_MAIL_FROM=""

# 方案 C · 外部 SMTP，仅 Node / VPS（465 隐式 TLS / 587 STARTTLS）
RECOVERY_SMTP_HOST=""
RECOVERY_SMTP_PORT="587"
RECOVERY_SMTP_USER=""
RECOVERY_SMTP_PASS=""

# ─── 微信小程序登录（jscode2session；不配则微信登录返回 WX_CONFIG_MISSING）───
# WX_APP_ID="wx24a39e0a660ee585"
WX_APP_ID=""
WX_APP_SECRET=""
