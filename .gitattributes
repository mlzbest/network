# 原有规则：dns-lookup 二进制走 Git LFS，勿删
functions/dns-lookup/dns-lookup filter=lfs diff=lfs merge=lfs -text

# 容器内执行的脚本必须是 LF：Windows 上若被 Git 自动转成 CRLF，
# shebang 会变成 `#!/bin/sh\r`，镜像启动时直接报 "not found"。
backend/docker-entrypoint.sh text eol=lf
backend/Dockerfile text eol=lf
backend/.dockerignore text eol=lf
Caddyfile text eol=lf
docker-compose.selfhost.yml text eol=lf
*.mjs text eol=lf
