# Cloudflare 部署凭证（不进 git，已在 .gitignore 的 .env.* 通配里被排除）
# 复制本文件为 `.env.cloudflare.local` 填入真实值：
#   cp .env.cloudflare.example .env.cloudflare.local
# 然后 bash deploy.sh workers 即可。
#
# ⚠️ 安全：CLOUDFLARE_API_TOKEN 权限应最小化（只勾 Worker Scripts = Edit + 你的 Account）。
#    别提交进 git；本地 export 也行，但写进 .env.cloudflare.local 更不易误提交。

CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""

# 可选：扩展 relay 白名单（JSON 数组字符串），不配则走代码内置 DEFAULT_WHITELIST
# 部署后用 `npx wrangler secret put RELAY_WHITELIST` 单独注入（不写进 git 的 vars 里）
# RELAY_WHITELIST='["deepseek.com","moonshot.ai","openai.com"]'
